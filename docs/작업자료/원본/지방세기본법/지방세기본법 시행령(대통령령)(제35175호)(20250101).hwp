혁' 또는 조문 앞의 '연' 아이콘을 통해 확인할 수 있습니다.</CHAR></TEXT></P><P ParaShape="2"><TEXT CharShape="6"></TEXT></P><P ParaShape="74"><TEXT CharShape="11"><CHAR>지방세기본법 시행령</CHAR><FIELDEND Type="Bookmark" Editable="false" Property="2"/></TEXT><TEXT CharShape="11"><CHAR></CHAR></TEXT></P>
<P ParaShape="16"><TEXT CharShape="42"><HEADER ApplyPageType="Both" TextWidth="51024" TextHeight="3600" HasTextRef="false" HasNumRef="false"><PARALIST TextDirection="0" LineWrap="Break" VertAlign="Top"><P ParaShape="13"><TEXT CharShape="9"><TABLE PageBreak="Cell" RepeatHeader="true" RowCount="1" ColCount="1" CellSpacing="0" BorderFill="2"><SHAPEOBJECT InstId="1201155746" ZOrder="0" NumberingType="Table" Lock="false"><SIZE Width="50929" Height="1982" WidthRelTo="Absolute" HeightRelTo="Absolute" Protect="false"/><POSITION TreatAsChar="true" AffectLSpacing="false" VertAlign="Top" HorzAlign="Left" VertOffset="0" HorzOffset="0" FlowWithText="true"/><OUTSIDEMARGIN Left="0" Right="0" Top="0" Bottom="0"/></SHAPEOBJECT><INSIDEMARGIN Left="510" Right="510" Top="141" Bottom="141"/><ROW><CELL ColAddr="0" RowAddr="0" ColSpan="1" RowSpan="1" Width="50929" Height="1982" Header="false" HasMargin="false" Protect="false" Editable="false" Dirty="false" BorderFill="4"><PARALIST TextDirection="0" LineWrap="Break" VertAlign="Center"><P ParaShape="13"><TEXT CharShape="9"><CHAR>지방세기본법 시행령</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR></CHAR></TEXT></P><P ParaShape="12"><TEXT CharShape="10"/></P></PARALIST></HEADER><FOOTER ApplyPageType="Both" TextWidth="51024" TextHeight="3600" HasTextRef="false" HasNumRef="false"><PARALIST TextDirection="0" LineWrap="Break" VertAlign="Bottom"><P ParaShape="14"><TEXT CharShape="10"/></P><P ParaShape="15"><TEXT CharShape="10"><TABLE PageBreak="Cell" RepeatHeader="true" RowCount="1" ColCount="3" CellSpacing="0" BorderFill="2"><SHAPEOBJECT InstId="1201155747" ZOrder="1" NumberingType="Table" Lock="false"><SIZE Width="50947" Height="1982" WidthRelTo="Absolute" HeightRelTo="Absolute" Protect="false"/><POSITION TreatAsChar="true" AffectLSpacing="false" VertAlign="Top" HorzAlign="Left" VertOffset="0" HorzOffset="0" FlowWithText="true"/><OUTSIDEMARGIN Left="0" Right="0" Top="0" Bottom="0"/></SHAPEOBJECT><INSIDEMARGIN Left="510" Right="510" Top="141" Botto